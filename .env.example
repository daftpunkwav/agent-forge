# API
PORT=3001
NODE_ENV=development
DATABASE_URL="file:./dev.db"
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5280
# 仅在反向代理后部署时设为 1；直连暴露时勿开（防伪造 X-Forwarded-For 绕过限流）
# TRUST_PROXY=1

# Web (Vite)
VITE_API_BASE_URL=http://localhost:3001/api/v1

# 种子管理员（db:seed 使用；PASSWORD 必填，无兜底口令）
SEED_ADMIN_EMAIL=admin@agentforge.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=AgentForge Admin
# 已存在同邮箱用户时，仅当设为 1 才提权为超管
# SEED_FORCE_ADMIN=1

# LLM Provider（服务端专用，切勿提交真实密钥）
LLM_PROVIDER_ID=stepfun
STEPFUN_API_KEY=
# Anthropic 兼容：base 填到 step_plan 即可（自动 /v1/messages）
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan
STEPFUN_MODEL=step-3.7-flash
STEPFUN_API_FORMAT=anthropic_messages
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_FORMAT=openai_chat
