# API
PORT=8181
# 绑定地址：默认仅本机回环；HOST=0.0.0.0 放开（容器/反向代理后，见 docs/operations/deployment.md）
# HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL="file:./dev.db"
# 生产 PostgreSQL（见 docs/postgres.md 与 docker compose；口令须与 docker compose 的 POSTGRES_PASSWORD 一致）：
# DATABASE_URL="postgresql://core:${POSTGRES_PASSWORD}@127.0.0.1:5432/core?schema=public"
JWT_SECRET=change-me-to-a-long-random-string-in-production
# 短时 access（默认 15m）；旧 JWT_EXPIRES_IN 仍可作回退
JWT_ACCESS_EXPIRES_IN=15m
# JWT_EXPIRES_IN=7d
# refresh 明文仅下发一次，服务端存 sha256；默认 7d
JWT_REFRESH_EXPIRES_IN=7d
# CORS：开发模式自动放行本机任意端口；生产仅此白名单（逗号分隔，生产必填，漏配拒绝全部跨源）
CORS_ORIGIN=http://localhost:8180
# 仅在反向代理后部署时设为 1；直连暴露时勿开（防伪造 X-Forwarded-For 绕过限流）
# TRUST_PROXY=1
# 日志级别：debug | info | warn | error（默认 development=debug，production=info）
# LOG_LEVEL=info
# BYOK apiKey 静态加密密钥（≥16 字符）。未设时回退用 JWT_SECRET 派生——生产建议单独配置
# BYOK_ENCRYPTION_KEY=

# Web (Vite)
# VITE_PORT=8180           # 前端开发服务器端口（默认 8180）
# VITE_API_PORT=8181       # 前端 /api 代理目标（默认跟随 PORT 或 8181；见 README）
# 同源代理模式（默认推荐）：不设 VITE_API_BASE_URL → 前端用相对路径 /api/v1，由 Vite dev proxy 转发；
# 后端端口变化只需改 PORT（VITE_API_PORT 可显式覆盖）。
# 直连跨源（仅前端独立部署时）：取消注释并填后端地址，同时需配生产 CORS_ORIGIN / CSP connect-src。
# VITE_API_BASE_URL=http://localhost:8181/api/v1

# 种子管理员（db:seed 使用；PASSWORD 必填，无兜底口令）
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin
# 已存在同邮箱用户时，仅当设为 1 才提权为超管
# SEED_FORCE_ADMIN=1

# LLM Provider（服务端专用，切勿提交真实密钥）
LLM_PROVIDER_ID=stepfun
STEPFUN_API_KEY=
# Anthropic 兼容：base 填到 step_plan 即可（自动 /v1/messages）
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan
STEPFUN_MODEL=step-3.7-flash
STEPFUN_API_FORMAT=anthropic_messages
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_FORMAT=openai_chat
# 通用兼容网关（可选）
# GENERIC_LLM_API_KEY=
# GENERIC_LLM_BASE_URL=
# GENERIC_LLM_MODEL=default
# GENERIC_LLM_API_FORMAT=openai_chat
# GENERIC_LLM_NAME=Generic
# GENERIC_LLM_VISION=false

# Agent tool-loop（面板 ReAct；可选）
# TOOL_LOOP_MAX_ITERS=5
# TOOL_TIMEOUT_MS=8000
# TOOL_LOOP_OVERALL_MS=75000   # ReAct 循环整体时限（须小于前端 tools 模式超时 90s）

# LLM 韧性（R-01/R-02，可选，有默认值）
# LLM_CIRCUIT_FAILURES=3        # 连续失败 N 次熔断
# LLM_CIRCUIT_OPEN_MS=30000     # 熔断冷却，期间快速 503
# LLM_MAX_CONCURRENT=12         # 进程内最大并发 LLM 调用
# LLM_QUEUE_WAIT_MS=5000        # 并发满员排队等位，超时 503

# R-04：BYOK 失败时是否回落服务端 Provider（默认关，配额隔离）
# LLM_BYOK_FALLBACK_TO_SERVER=1
