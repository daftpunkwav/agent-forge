  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^10.1.0",
    "oxlint": "^1.76.0",
    "typescript": "~5.9.3",
    "vite": "^8.1.1",
    "vitest": "^3.2.7"
